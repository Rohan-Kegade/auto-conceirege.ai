# --- App ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-me
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autoconcierge

# --- LLM / embeddings (LangChain) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# --- Vector store ---
VECTOR_STORE=pgvector          # pgvector | chroma
VECTOR_STORE_URL=              # e.g. chroma persist dir or pgvector DSN
RETRIEVAL_TOP_K=8

# --- Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=40
