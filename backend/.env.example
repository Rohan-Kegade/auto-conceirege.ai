# --- App ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-me
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14

# --- Database (Postgres) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autoconcierge

# --- LLM + embeddings (Google Gemini) ---
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash
EMBEDDING_PROVIDER=google              # google | fastembed
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIM=768
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5 # used when EMBEDDING_PROVIDER=fastembed (384 dim)

# --- Vector store (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=brochure_chunks
RETRIEVAL_TOP_K=8

# --- Ingestion queue (arq / Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=40
